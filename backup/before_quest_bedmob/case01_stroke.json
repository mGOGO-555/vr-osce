{
  "station_id": "stroke_sts_01",
  "title": "脳卒中片麻痺患者の立ち上がり・移乗前評価",
  "room": {
    "number": "305",
    "name": "田中 一郎"
  },
  "patient": {
    "model": "./assets/patient_case01.glb",
    "placement": {
      "x": 0.5,
      "z": -1.0,
      "yaw_deg": 90
    },
    "bedmob": true,
    "motion": {
      "type": "hemiparesis",
      "side": "right",
      "severity": 1,
      "breath": {
        "rate": 16,
        "amp": 1
      }
    },
    "voice": {
      "pitch": 0.8,
      "rate": 0.85
    }
  },
  "props": {
    "wheelchair": true
  },
  "time_limit_sec": 420,
  "intro": "あなたは担当理学療法士です。\n\n72歳男性、脳卒中後右片麻痺、発症後3週間。\n\nベッドサイドで患者の状態を評価し、安全に立ち上がり・移乗が可能か判断してください。\n\n制限時間：7分",
  "sit_to_stand": {
    "during_text": "患者が立ち上がります。\n動作をよく観察してください。",
    "after_text": "立ち上がり動作が終わりました。\n気づいた点を観察してください。",
    "observations": [
      {
        "id": "observe_trunk_lean",
        "label": "体幹の動き",
        "response": "体幹の前傾がやや不足したまま、臀部が離床した。",
        "if_assist": {
          "assist_trunk": "体幹の前傾を介助で誘導したことで、十分な前傾が得られ、スムーズに臀部が離床した。"
        }
      },
      {
        "id": "observe_foot_after_stand",
        "label": "足部と荷重",
        "response": "右足が前方に残ったまま立ち上がった。左下肢への荷重が増えた。",
        "if_assist": {
          "assist_pelvis": "骨盤を支えたことで、左下肢への荷重の偏りが軽減した。右足は前方に残ったまま立ち上がった。"
        }
      },
      {
        "id": "observe_knee_instability",
        "label": "右膝の状態",
        "response": "立位直後に右膝の支持性が低下し、軽度の膝折れがみられた。",
        "if_assist": {
          "assist_right_knee": "右膝を支えたことで、立位直後の膝折れはみられなかった。"
        }
      }
    ]
  },
  "judgement": {
    "steps": [
      {
        "id": "problem",
        "type": "rank",
        "max_select": 3,
        "prompt": "この患者の問題点を、重要だと思う順に最大3つ選んでください。\n（選んだ順が優先順位です。もう一度押すと取り消せます）",
        "log_prefix": "select_problem",
        "options": [
          {
            "id": "right_leg_support",
            "label": "右下肢の支持性低下（右膝折れ）",
            "weight": 3,
            "rationale": "立ち上がりで右膝折れ。MMT膝伸展3、Brunnstrom Ⅲ。転倒に直結するため最優先"
          },
          {
            "id": "weight_shift_left",
            "label": "荷重の左側への偏り",
            "weight": 2,
            "rationale": "座位6:4、立位7:3で左へ偏り、右下肢で支えにくい"
          },
          {
            "id": "foot_position",
            "label": "右足部が前方に残る",
            "weight": 2,
            "rationale": "足部が前方だと荷重移動が不十分になりやすい"
          },
          {
            "id": "trunk_lean",
            "label": "体幹の前傾不足",
            "weight": 2,
            "rationale": "前傾不足のまま離臀すると重心移動が不十分"
          },
          {
            "id": "left_leg_weakness",
            "label": "左下肢の筋力低下",
            "weight": 1,
            "rationale": "左下肢はMMT5で保たれており、優先度は低い"
          },
          {
            "id": "severe_dizziness",
            "label": "強いめまい",
            "weight": 0,
            "rationale": "めまいの訴えはない"
          },
          {
            "id": "paretic_sensory_impairment",
            "label": "麻痺側の感覚障害",
            "weight": 1,
            "rationale": "右下肢の感覚は軽度低下（触覚7/10、位置覚3/5）。ただし最優先ではない"
          }
        ]
      },
      {
        "id": "action",
        "prompt": "次にどのような対応をしますか？",
        "log_prefix": "select_action",
        "options": [
          {
            "id": "walk_as_is",
            "label": "そのまま歩行させる",
            "correct": false,
            "score": 0
          },
          {
            "id": "adjust_and_reassess",
            "label": "足部位置と介助方法を調整して再評価する",
            "correct": true,
            "score": 2
          },
          {
            "id": "repeat_stand_unassisted",
            "label": "介助なしで繰り返し立たせる",
            "correct": false,
            "score": 0
          },
          {
            "id": "fast_walk_now",
            "label": "すぐに高速歩行を行う",
            "correct": false,
            "score": 0
          },
          {
            "id": "end_assessment",
            "label": "評価を終了する",
            "correct": false,
            "score": 0
          }
        ]
      }
    ]
  },
  "menu": [
    {
      "id": "interview",
      "label": "問診",
      "type": "dialogue",
      "items": [
        {
          "id": "ask_pain",
          "label": "痛みはありますか？",
          "response": "右肩が少し痛いです。",
          "say": [
            "いたくな",
            "きつい所",
            "ずきずき",
            "どこか痛",
            "いたい",
            "つらい",
            "痛くな",
            "違和感",
            "いた",
            "痛い",
            "辛い",
            "痛"
          ]
        },
        {
          "id": "ask_dizziness",
          "label": "めまいや気分不良はありませんか？",
          "response": "ありません。",
          "say": [
            "たいちょう",
            "たちくらみ",
            "気持ちわる",
            "立ちくらみ",
            "くらくら",
            "ふらふら",
