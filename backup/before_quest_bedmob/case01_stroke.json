        {
          "id": "assist_trunk",
          "label": "体幹を支える",
          "response": "患者の体幹を支え、前傾を誘導する。",
          "effect": "trunk",
          "zone": true
        },
        {
          "id": "assist_pelvis",
          "label": "骨盤を支える",
          "response": "患者の骨盤を支え、左右への重心の偏りを抑える。",
          "effect": "pelvis",
          "zone": true
        }
      ],
      "hint": "（患者の右膝・体幹・骨盤に手を近づけて触れても介助できます）"
    }
