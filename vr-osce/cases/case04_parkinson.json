            "こんご"
          ]
        }
      ]
    },
    {
      "id": "observe",
      "label": "観察",
      "type": "finding",
      "items": [
        {
          "id": "observe_posture",
          "label": "座位姿勢",
          "response": "体幹が前に傾き、頭が前に出ている（円背）。肩は内側に丸まっている。"
        },
        {
          "id": "observe_face_voice",
          "label": "表情・声",
          "response": "表情は乏しく、まばたきが少ない。声は小さく、抑揚が少ない。"
        },
        {
          "id": "observe_tremor",
          "label": "振戦・動作の速さ",
          "response": "安静時の手の震えは目立たない。動作は全体にゆっくりで、動き出すまでに時間がかかる。"
        },
        {
          "id": "observe_environment",
          "label": "歩行器・周囲の環境",
          "response": "歩行器を使用している。廊下は平らだが、病室の出入口に小さな段差（敷居）がある。"
        }
      ]
    },
    {
      "id": "assess",
      "label": "評価項目",
      "type": "result",
      "items": [
        {
          "id": "assess_vitals",
          "label": "バイタルサイン（血圧・脈拍）",
          "response": "【座位・安静】血圧 124／72 mmHg、脈拍 68 回/分、SpO2 97%。",
          "if_state": {
            "stood": "【立位直後】血圧 104／60 mmHg、脈拍 74 回/分。立位後にふらつきの訴えがある。"
          }
        },
        {
          "id": "assess_rigidity",
          "label": "筋強剛・関節可動域",
          "response": "頸部・体幹・右上肢に軽度の筋強剛（歯車様）。股関節・膝関節の伸展は −10°。"
        },
        {
          "id": "assess_postural_reflex",
          "label": "姿勢反射（後方への引き込み）",
          "response": "後方へ軽く引くと立て直す反応が遅れ、数歩後ろに下がる。支えがないと倒れる危険がある。"
        },
        {
          "id": "assess_muscle",
          "label": "下肢筋力",
          "response": "【MMT】下肢 4レベル（左右差なし）。"
        },
        {
          "id": "assess_sit_to_stand",
          "label": "立ち上がり評価",
          "response": null,
          "log_action": "start_sit_to_stand"
        },
        {
          "id": "assess_standing",
          "label": "立位保持",
          "response": "【立位保持】前傾・円背の姿勢で、歩行器につかまって保持できる。保持中に体幹が小さく前後に揺れる。見守りが必要。"
        },
        {
          "id": "assess_gait",
          "label": "歩行（歩行器で前方へ数歩）",
          "response": "【歩行】歩き出しまでに約2秒かかる（すくみ）。その後は歩幅が小さく、すり足で、進むにつれて歩幅がさらに小さく、足の運びが速くなる。方向を変えるときは足が止まりやすい。",
          "if_assist": {
            "assist_visual_cue": "【歩行】床に目印を置いたことで、歩き出しまでの時間が短くなった。歩幅が大きくなり、前方へ数歩進めた。"
          }
        }
      ]
    },
    {
      "id": "safety",
      "label": "安全確認",
      "type": "result",
      "items": [
        {
          "id": "check_patient",
          "label": "患者の状態を確認する",
          "response": "意識は清明で、会話は成立する。動作は遅いが、指示は理解できている。"
        },
        {
          "id": "check_walker",
          "label": "歩行器の高さ・状態を確認する",
          "response": "歩行器の高さはグリップが手首の高さに合っている。ストッパーとゴム足は問題ない。"
        },
        {
          "id": "check_environment",
          "label": "周囲の環境（床・段差・障害物）を確認する",
          "response": "床は乾いていて障害物はない。出入口の敷居を避け、広い通路で行う。進行方向に休める椅子を用意した。"
        },
        {
          "id": "check_stop_criteria",
          "label": "運動の中止基準を確認する",
          "response": "中止基準：強いふらつき、後方への転倒しそうな動揺、立位での血圧低下の症状、すくみが続いて動けなくなった場合。"
        }
      ]
    },
    {
      "id": "assist",
      "label": "介助・声かけ",
      "type": "result",
      "items": [
        {
          "id": "assist_voice",
          "label": "声かけをする",
          "response": "「ゆっくり立ちましょう。足が止まったら教えてください。」と伝えた。患者は「はい」とうなずいた。"
        },
        {
          "id": "assist_visual_cue",
          "label": "視覚的な合図（床の目印）を出す",
          "effect": "cue",
          "response": "床に目印のテープを置き、「この線をまたぎましょう」と声をかけた。患者は目印を見て、足を出しやすくなった。"
        },
        {
          "id": "assist_auditory_cue",
          "label": "掛け声（1、2、1、2）で合図する",
          "response": "リズムに合わせようとしたが、この患者では歩き出しに変化はなかった。"
        },
        {
          "id": "assist_guard",
          "label": "後方で見守る位置につく",
          "response": "患者の後方やや横に立ち、後ろへ倒れそうになった場合に支えられる位置をとった。"
        }
      ]
    }
  ],
  "sit_to_stand": {
    "during_text": "患者が立ち上がります。\n動作をよく観察してください。",
    "after_text": "立ち上がり動作が終わりました。\n気づいた点を観察してください。",
    "observations": [
      {
        "id": "observe_stand_motion",
        "label": "立ち上がり動作",
        "response": "体を前後に揺らして、立ち上がるまでに何度か反動をつけた。動き出しに時間がかかり、立ち上がりはゆっくりだった。"
      },
      {
        "id": "observe_stand_posture",
        "label": "立位姿勢",
        "response": "前傾・円背のまま、膝を軽く曲げて立っている。歩行器のグリップにしっかりつかまっている。"
      },
      {
        "id": "observe_balance",
        "label": "立位のバランス",
        "response": "立位後に体幹が小さく前後に揺れる。立位でふらつきの訴えがある。"
      }
    ]
  },
