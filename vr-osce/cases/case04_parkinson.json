        "options": [
          {
            "id": "freezing_fall_risk",
            "label": "すくみ足と姿勢反射障害による転倒リスク",
            "weight": 3,
            "rationale": "歩き出し・方向転換でのすくみ、後方への立て直しの遅れ、3か月で2回の転倒歴があり、最優先"
          },
          {
            "id": "stooped_small_steps",
            "label": "前傾姿勢・小刻み歩行（動作の遅さ）",
            "weight": 2,
            "rationale": "歩幅が進むほど小さくなり、歩行の効率と安全性を下げる"
          },
          {
            "id": "orthostatic_drop",
            "label": "起立時の血圧低下とふらつき",
            "weight": 2,
            "rationale": "立位直後に血圧が低下し、ふらつきの訴えがある"
