            "立位"
          ]
        },
        {
          "id": "ask_right_foot_sensation",
          "label": "右足の感覚は分かりますか？",
          "response": "左より少し分かりにくいです。",
          "say": [
            "かんかく",
            "かんじ",
            "しびれ",
            "動かし",
            "右の足",
            "足の感",
            "さわ",
            "まひ",
            "みぎ",
            "右側",
            "右足",
            "感じ",
            "感覚",
            "痺れ",
            "足は",
            "麻痺",
            "触"
          ]
        }
      ]
    },
    {
      "id": "observe",
      "label": "観察",
      "type": "finding",
      "items": [
        {
          "id": "observe_posture",
          "label": "座位姿勢",
          "response": "座位は保持できている。体幹はやや左側へ傾いている。"
        },
        {
          "id": "observe_weight_bearing",
          "label": "左右の荷重",
          "response": "体重は主に左側へ偏っている。"
        },
        {
          "id": "observe_foot_position",
          "label": "足部位置",
          "response": "右足部が左足部よりやや前方に位置している。"
        },
        {
          "id": "observe_paretic_arm",
          "label": "麻痺側上肢",
          "response": "右上肢は麻痺側で、体側から大腿上に置かれている。"
        },
        {
          "id": "observe_arousal",
          "label": "患者の覚醒状態",
          "response": "意識は清明で、簡単な指示を理解している。"
        }
      ]
    },
    {
      "id": "assess",
      "label": "評価項目",
      "type": "result",
      "items": [
        {
          "id": "assess_sensation",
          "label": "感覚検査",
          "response": "【感覚検査】右下肢は左に比べて軽度に低下。\n表在感覚（触覚）：右 7/10（左 10/10）\n深部感覚（位置覚）：右 3/5 回正答（左 5/5）"
        },
        {
          "id": "assess_lower_limb_strength",
          "label": "下肢筋力評価",
          "response": "【MMT（徒手筋力検査）】\n右：股屈曲 3、股伸展 3、膝伸展 3、膝屈曲 3、足背屈 2、足底屈 3\n左：股・膝・足関節とも 5（保たれている）"
        },
        {
          "id": "assess_motor_paralysis",
          "label": "運動麻痺評価",
          "response": "【運動麻痺の評価（右下肢）】\nBrunnstrom stage：Ⅲ（共同運動パターンでの随意運動が可能）\nFugl-Meyer 下肢運動項目：17/34点\nSIAS 運動機能：股屈曲テスト 3、膝伸展テスト 3、足パットテスト 2（各 0〜5）"
        },
        {
          "id": "assess_sitting_balance",
          "label": "座位バランス",
          "response": "座位は上肢の支持なしで保持できる（静的）。体重は左側へ偏位し、体幹はやや左へ傾斜している。\n座位荷重 左:右 ≒ 6:4"
        },
        {
          "id": "assess_sit_to_stand",
          "label": "立ち上がり評価",
          "response": null,
          "log_action": "start_sit_to_stand"
        },
        {
          "id": "assess_standing",
          "label": "立位保持",
          "response": "【立位保持】支持物を用いて保持できるが、右膝の支持性が不安定。\n荷重 左:右 ≒ 7:3。持続は約10秒で、右膝の不安定さのため介助が必要になる。",
          "if_assist": {
            "assist_right_knee": "【立位保持】右膝を支えており、膝折れなく保持できた。\n荷重 左:右 ≒ 7:3（右膝を支えた状態で約10秒保持）。"
          }
        },
        {
          "id": "assess_gait",
          "label": "歩行",
          "response": "【歩行】介助下で数歩（約4歩）は可能。右立脚期に膝折れが生じやすく、介助量が多い。\nFAC（歩行自立度）：1（持続的な介助が必要）",
          "if_assist": {
            "assist_right_knee": "【歩行】右膝を支えることで膝折れなく数歩（約4歩）の歩行が可能だった。介助量は多い。\nFAC（歩行自立度）：1（持続的な介助が必要）"
          }
        }
      ]
    },
    {
      "id": "safety",
      "label": "安全確認",
      "type": "result",
      "items": [
        {
          "id": "check_patient",
          "label": "患者の状態を確認する",
          "response": "意識は清明で、ベッド端で座位を保持している。"
        },
        {
          "id": "check_wheelchair_brake",
          "label": "車椅子のブレーキを確認する",
          "response": "車椅子のブレーキを確認し、ロックした。"
        },
        {
          "id": "check_pre_stand_safety",
          "label": "立ち上がり前の安全を確認する",
          "response": "周囲に障害物はなく、立ち上がるスペースが確保されている。"
        }
      ]
    },
    {
      "id": "assist",
      "label": "介助・声かけ",
      "type": "result",
      "items": [
        {
          "id": "assist_voice",
          "label": "声かけをする",
          "response": "「立ちますよ。体を前に倒して、1、2の3で立ちましょう。」と合図を伝えた。患者は「はい」と答えた。"
        },
        {
          "id": "assist_right_knee",
          "label": "右膝を支える",
          "response": "患者の右膝を前方から支え、膝が折れないよう介助する。",
          "effect": "knee",
          "zone": true
