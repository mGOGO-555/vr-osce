            "暮らし",
            "くらし",
            "歩行器",
            "ほこうき",
            "敷居",
            "しきい",
            "トイレ",
            "といれ"
          ]
        },
        {
          "id": "ask_goal",
          "label": "これからどうなりたいですか？",
          "response": "転ばずに、家の中を安全に歩けるようになりたいです。",
          "say": [
            "これから",
            "どうなりたい",
            "希望",
            "きぼう",
            "目標",
            "もくひょう",
            "願い",
