      },
      {
        "id": "action",
        "prompt": "次にどのような対応をしますか？",
        "log_prefix": "select_action",
        "options": [
          {
            "id": "visual_cue_guarded_walk",
            "label": "視覚的な合図で歩き出しを促し、後方で見守りながら、短い距離から歩行練習を進める",
            "correct": true,
            "score": 2
          },
          {
            "id": "auditory_cue_only",
            "label": "掛け声だけで合図して、歩行距離を延ばす",
            "correct": false,
            "score": 1
          },
          {
            "id": "bed_rest_only",
            "label": "転倒のリスクが高いため、歩行練習はせず、ベッド上で過ごすよう勧める",
            "correct": false,
            "score": 1
          },
          {
            "id": "remove_walker",
            "label": "歩行器を外して、介助なしで歩かせて自立度をみる",
            "correct": false,
            "score": 0
          },
          {
            "id": "pull_to_walk",
            "label": "足が止まったら、手を強く引いて歩かせる",
            "correct": false,
            "score": 0
          }
        ]
      }
    ]
