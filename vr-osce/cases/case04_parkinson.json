            "波"
          ]
        },
        {
          "id": "ask_fall",
          "label": "転んだことはありますか？",
          "response": "この3か月で2回転びました。後ろに倒れそうになることがあります。",
          "say": [
            "転",
            "ころ",
            "転倒",
            "てんとう",
            "倒れ",
            "たおれ",
            "つまづ",
            "つまず",
            "ふらつ",
            "後ろに",
            "うしろに"
          ]
        },
        {
          "id": "ask_dizziness",
          "label": "立ち上がるとき、めまいやふらつきはありませんか？",
          "response": "立ったときに、ふらっとすることが時々あります。",
          "say": [
            "めまい",
            "立ちくらみ",
            "たちくらみ",
            "ふらっと",
            "ふらふら",
            "立ち上が",
