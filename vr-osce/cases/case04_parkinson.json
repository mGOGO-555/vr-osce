          {
            "id": "right_hemiparesis",
            "label": "右下肢の運動麻痺",
            "weight": 0,
            "rationale": "麻痺はない。筋強剛と混同しない"
          },
          {
            "id": "exertional_dyspnea",
            "label": "労作時の呼吸困難",
            "weight": 0,
            "rationale": "息切れの訴えはない"
